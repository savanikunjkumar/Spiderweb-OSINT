# ==========================================
# SPIDERWEB OSINT - BACKEND SECURE CONTAINER
# ==========================================

# 1. BASE IMAGE
# Using Python 3.11 slim to reduce the attack surface and container size
FROM python:3.11-slim

# 2. ENVIRONMENT VARIABLES
# Prevents Python from writing .pyc files to disk
ENV PYTHONDONTWRITEBYTECODE=1
# Ensures logs are pushed to the terminal immediately without buffering
ENV PYTHONUNBUFFERED=1

# 3. WORKSPACE SETTINGS
WORKDIR /app

# 4. SYSTEM DEPENDENCIES
# Installing essential build tools required for ReportLab PDF compilation
RUN apt-get update && apt-get install -y \
    build-essential \
    libfreetype6-dev \
    && rm -rf /var/lib/apt/lists/*

# 5. PYTHON DEPENDENCIES
# Copying requirements first to leverage Docker layer caching (speeds up future builds)
COPY requirements.txt .

# Upgrade pip and install libraries without caching to save storage space
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# 6. INGEST SOURCE CODE
# Copy the core engine logic into the secure container
COPY main.py osint_engine.py ./

# 7. NETWORK EXPOSURE
# Exposing port 8000 to link with the Docker-Compose network
EXPOSE 8000

# 8. IGNITION SEQUENCE
# Launch the FastAPI engine using Uvicorn
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
